{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["Seagulll"],
  "contact": {
    "sources": "${mod_sources}",
    "homepage": "${mod_sources}",
    "issues": "${mod_sources}/issues"
  },
  "license": "MIT",
  "icon": "assets/worlddateformatter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.seagulll.worlddateformatter.WDF"
    ],
    "modmenu": [
      "me.seagulll.worlddateformatter.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "worlddateformatter.mixins.json"
  ],
  "depends": {
    "minecraft": "${mc_version_range}",
    "fabricloader": ">=${loader_version}"
  },
  "recommends": {
    "modmenu": "*",
    "yet_another_config_lib_v3": "*"
  }
}
