{
  "schemaVersion": 1,
  "id": "worlddateformatter",
  "version": "${version}",
  "name": "World Date Formatter",
  "description": "Custom date format for the last played date.",
  "authors": ["Seagulll"],
  "contact": {
    "sources": "${mod_sources}",
    "homepage": "${mod_sources}",
    "issues": "${mod_sources}/issues"
  },
  "license": "MIT",
  "icon": "assets/worlddateformatter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.seagulll.worlddateformatter.WDF"
    ],
    "modmenu": [
      "me.seagulll.worlddateformatter.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "worlddateformatter.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}"
  },
  "recommends": {
    "modmenu": "*",
    "yet_another_config_lib_v3": "*"
  }
}
